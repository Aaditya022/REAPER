  - setup: backend
    build:
      base: python@3.11
      buildCommands:
        - cd backend && pip install -r requirements.txt
      deployFiles:
        - backend/~
    run:
      base: python@3.11
      ports:
        - port: 8000
          httpSupport: true
{{envVariables}}
      start: python manage.py runserver 0.0.0.0:8000
