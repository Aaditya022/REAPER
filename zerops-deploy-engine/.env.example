# STACKD Ignition — local environment template
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# --- Zerops API credentials ---
# Create a token: Zerops console -> Project -> Access tokens.
ZEROPS_API_TOKEN=
# Target Zerops project id (uuid shown in project settings).
ZEROPS_PROJECT_ID=

# --- Optional overrides (defaults live in application.yml) ---
# IGNITION_PORT=8080
# ZEROPS_API_BASE_URL=https://api.app-prg1.zerops.io/api/rest/public
# ZEROPS_API_TIMEOUT_MS=30000
# IGNITION_POLL_INTERVAL_MS=5000
# IGNITION_MAX_POLL_INTERVAL_MS=60000
# IGNITION_POLL_TIMEOUT_MS=300000
# IGNITION_HEALTH_TIMEOUT_MS=30000
# IGNITION_DEPLOY_EXECUTOR_POOL_SIZE=4

# --- Database credentials forwarded into generated zerops.yaml ---
# Fill in only the block matching the stack you deploy.
# postgres (used by Prisma/Drizzle with a postgres database)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# mysql
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_PORT=3306

# mongodb
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
MONGO_INITDB_DATABASE=
MONGO_PORT=27017
